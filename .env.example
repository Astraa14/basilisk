# Basilisk LLM configuration — copy to .env (which is gitignored)
# Never commit real keys.
#
# Basilisk is a STANDALONE LOCAL CLI scanner.
# No Basilisk account, backend, or dashboard is needed.
# The only external connections Basilisk makes are:
#   1. Scanning the target URL you specify
#   2. Calling your configured LLM provider (optional)
#   3. Connecting to a local Ollama instance (optional)
#
# ── Option A: Cloud / OpenAI-compatible provider ──
BASILISK_LLM_API_KEY=sk-your-key-here
BASILISK_LLM_BASE_URL=https://api.openai.com/v1
BASILISK_LLM_MODEL=gpt-4o-mini

# ── Option B: Local Ollama (no cloud key needed) ──
# BASILISK_LLM_BASE_URL=http://localhost:11434/v1
# BASILISK_LLM_API_KEY=ollama
# BASILISK_LLM_MODEL=llama3.2

# ── Option C: No LLM — use `basilisk scan <url> --no-llm` ──
